# Copy to .env (`cp .env.sample .env`) and adjust. .env is git-ignored.
# Loaded automatically in development and test by the dotenv gem.

# MySQL connection
DATABASE_USERNAME=root
DATABASE_PASSWORD=
# Leave unset to use the local socket (/tmp/mysql.sock); set to connect over TCP.
# DATABASE_HOST=127.0.0.1

# JWT signing secret. Optional locally (falls back to secret_key_base);
# set a long random value in production: `bin/rails secret`
DEVISE_JWT_SECRET_KEY=

# Comma-separated origins allowed to call the API (the React app)
FRONTEND_ORIGINS=http://localhost:5173

# HR Manager created by `bin/rails db:seed` (password is required in production)
SEED_HR_EMAIL=hr@acme.com
SEED_HR_PASSWORD=ChangeMe123!
# How many demo employees `bin/rails db:seed` creates
SEED_EMPLOYEE_COUNT=10000
